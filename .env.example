# ---------------------------------------------------------------------------
# Example environment file - contains NO real secrets.
#
# Usage (Git Bash / Linux):
#   cp .env.example .env        # .env is ignored by Git
#   nano .env                   # fill in your LAB values
#   source .env
#
# If you leave NETAUTO_PASSWORD out, netauto asks for it securely at runtime
# (recommended - the password is then never stored on disk).
# ---------------------------------------------------------------------------
export NETAUTO_USERNAME="netadmin"
# export NETAUTO_PASSWORD="replace-with-your-lab-password"
# export NETAUTO_ENABLE_SECRET="replace-with-your-lab-enable-secret"

# Optional: keep real backups OUTSIDE the public project folder
# export NETAUTO_BACKUP_DIR="$HOME/netauto-config-backups"
